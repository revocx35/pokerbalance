# Copy to .env and adjust. Everything is optional.

# TLS: self-signed (default, cert generated in ./data/tls), custom (set the two paths), or off
# (plain HTTP - only behind a TLS-terminating reverse proxy that is the only thing able to reach the port).
#POKER_TLS=self-signed
#POKER_TLS_CERT=/data/tls/fullchain.pem
#POKER_TLS_KEY=/data/tls/privkey.pem

# Reverse proxies whose X-Forwarded-For is trusted for the login rate limit (IPs/CIDRs, or "private").
#POKER_TRUSTED_PROXIES=192.0.2.10

# Session lifetime: signed out after this much inactivity / at the latest after this many days.
#POKER_SESSION_IDLE_HOURS=168
#POKER_SESSION_MAX_DAYS=30

# Currency symbol suggested for new groups.
#POKER_DEFAULT_CURRENCY=₺
